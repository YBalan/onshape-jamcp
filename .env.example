# Copy to .env (git-ignored) for local runs and for scripts/smoke_test.py.
# MCP clients (Claude Desktop, Cursor, ...) take these in their own "env" block instead -
# see docs/getting-started.md.

# --- Required: create keys at https://dev-portal.onshape.com/keys ---------------------------
ONSHAPE_ACCESS_KEY=
ONSHAPE_SECRET_KEY=

# --- Alternative to API keys: your own Onshape OAuth application (see docs/oauth.md) ---------
# Then run `onshape-jamcp auth login` once. API keys win if both are set (ONSHAPE_AUTH_MODE=oauth
# forces OAuth). Redirect URL to register: http://localhost:18339/callback
# ONSHAPE_OAUTH_CLIENT_ID=
# ONSHAPE_OAUTH_CLIENT_SECRET=

# --- Units: metric (millimeters, default) or imperial (inches) -------------------------------
ONSHAPE_UNITS=metric

# --- Screenshots: true = send images to the LLM for review (uses tokens), false = save only --
ONSHAPE_SCREENSHOT_REVIEW=true

# --- Optional -------------------------------------------------------------------------------
# ONSHAPE_READ_ONLY=false
# ONSHAPE_BASE_URL=https://cad.onshape.com      # enterprise: https://yourcompany.onshape.com
# ONSHAPE_OUTPUT_DIR=./output
